{
  "description": "StudioMeyer Memory: recall on every prompt, close the memory session when the Claude Code session ends. Loads automatically while the plugin is enabled.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:studiomeyer-memory:studiomeyer-memory",
            "tool": "nex_search",
            "input": { "query": "${prompt}", "limit": 5 },
            "timeout": 10,
            "statusMessage": "Memory: recalling..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:studiomeyer-memory:studiomeyer-memory",
            "tool": "nex_session_end",
            "input": {},
            "timeout": 20,
            "statusMessage": "Memory: closing session..."
          }
        ]
      }
    ]
  }
}
