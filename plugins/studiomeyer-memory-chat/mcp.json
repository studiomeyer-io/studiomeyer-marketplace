{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "studiomeyer-memory-full": {
      "type": "streamable-http",
      "url": "https://memory.studiomeyer.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://memory.studiomeyer.io/mcp",
            "defaultScopes": [
              "memory"
            ]
          }
        }
      }
    }
  }
}
